<Window x:Class="RssAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RssAgent" Height="820" Width="1200">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <TabControl>
        <TabItem Header="聊天">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="自然语言描述" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="生成并添加" Command="{Binding GenerateAndAddFromChatCommand}" Width="120" Margin="0,0,8,0"/>
                        <Button Content="推荐并添加" Command="{Binding RecommendFromChatCommand}" Width="120"/>
                    </StackPanel>
                </StackPanel>

                <GroupBox Header="结果" Grid.Row="1" Margin="0,0,0,12">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="RSSHub URL" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding AddSubscription.OutputRssUrl}" Grid.Row="0" Grid.Column="1" IsReadOnly="True"/>

                        <TextBlock Text="新增 Feed" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding AddSubscription.AddedSourceName}" Grid.Row="1" Grid.Column="1" IsReadOnly="True"/>

                        <TextBlock Text="状态/错误" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding AddSubscription.StatusMessage}" Grid.Row="2" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="标签" Grid.Row="2" Margin="0,0,0,12">
                    <StackPanel Margin="12">
                        <ItemsControl ItemsSource="{Binding AddSubscription.TagOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,12,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="额外标签(逗号分隔)" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding AddSubscription.ExtraTags, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="推荐列表" Grid.Row="3">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                            <Button Content="添加选中" Command="{Binding Recommend.AddSelectedCommand}" Width="120" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Recommend.StatusMessage}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Recommend.Recommendations}" AutoGenerateColumns="False" Grid.Row="1">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="选中" Binding="{Binding IsSelected}" Width="60"/>
                                <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="标签" Binding="{Binding TagsDisplay}" Width="*"/>
                                <DataGridTextColumn Header="路由/URL" Binding="{Binding RouteDisplay}" Width="2*"/>
                                <DataGridTextColumn Header="备注" Binding="{Binding Notes}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding Recommend.StatusMessage}" Grid.Row="2" Margin="0,8,0,0"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </TabItem>

        <TabItem Header="设置">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16" Orientation="Vertical">
                    <GroupBox Header="RSSBox" Margin="0,0,0,12">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="BaseUrl" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Settings.RssBoxBaseUrl, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                            <Button Content="测试 RSSBox" Command="{Binding Settings.TestRssBoxCommand}" Grid.Row="0" Grid.Column="2" Margin="8,0,0,0"/>

                            <TextBlock Text="用户名" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Settings.RssBoxUsername, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>

                            <TextBlock Text="密码" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                            <PasswordBox Grid.Row="2" Grid.Column="1" PasswordChanged="RssBoxPasswordChanged"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="RSSHub" Margin="0,0,0,12">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="BaseUrl" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Settings.RssHubBaseUrl, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                            <Button Content="测试 RSSHub" Command="{Binding Settings.TestRssHubCommand}" Grid.Row="0" Grid.Column="2" Margin="8,0,0,0"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Gemini" Margin="0,0,0,12">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="API Key" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                            <PasswordBox Grid.Row="0" Grid.Column="1" PasswordChanged="GeminiApiKeyChanged"/>
                            <Button Content="测试 Gemini" Command="{Binding Settings.TestGeminiCommand}" Grid.Row="0" Grid.Column="2" Margin="8,0,0,0"/>

                            <TextBlock Text="模型名" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Settings.GeminiModel, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="默认策略(来自 RSSBox)" Margin="0,0,0,12">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="翻译 Agent" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Settings.TranslatorOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Settings.DefaultTranslatorOption}"
                                      Grid.Row="0" Grid.Column="1"/>

                            <TextBlock Text="摘要 Agent" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Settings.SummarizerOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Settings.DefaultSummarizerOption}"
                                      Grid.Row="1" Grid.Column="1"/>

                            <TextBlock Text="默认过滤器" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Settings.FilterOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Settings.DefaultFilterOption}"
                                      Grid.Row="2" Grid.Column="1"/>

                            <TextBlock Text="译文显示方式" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Settings.TranslationDisplayOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Settings.DefaultTranslationDisplay}"
                                      Grid.Row="3" Grid.Column="1"/>
                        </Grid>
                    </GroupBox>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="保存设置" Command="{Binding Settings.SaveCommand}" Width="120" Margin="0,0,8,0"/>
                        <Button Content="导出配置" Command="{Binding Settings.ExportConfigCommand}" Width="120" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Settings.StatusMessage}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <GroupBox Header="健康检查" Margin="0,0,0,12">
                        <ItemsControl ItemsSource="{Binding Settings.HealthChecks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ServiceName}" Width="120"/>
                                        <TextBlock Text="{Binding Detail}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <GroupBox Header="快照调试" Visibility="{Binding Settings.IsSnapshotDebugEnabled, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="12">
                            <TextBlock Text="Snapshot 目录" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Settings.SnapshotDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="从快照解析并预览" Command="{Binding Settings.PreviewSnapshotCommand}" Width="160" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding Settings.SnapshotPreview}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="80" Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="RSSBox 数据">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                    <Button Content="刷新" Command="{Binding Feeds.RefreshCommand}" Width="100" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Feeds.StatusMessage}" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Feeds.Feeds}" AutoGenerateColumns="False" Grid.Column="0" Margin="0,0,8,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="2*"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid ItemsSource="{Binding Feeds.Tags}" AutoGenerateColumns="False" Grid.Column="1" Margin="0,0,8,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="标签" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid ItemsSource="{Binding Feeds.Digests}" AutoGenerateColumns="False" Grid.Column="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Digest" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="频率" Binding="{Binding Schedule}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="Digest">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                    <Button Content="刷新" Command="{Binding Digests.RefreshCommand}" Width="100" Margin="0,0,8,0"/>
                    <Button Content="打开 RSSBox Digest 页面" Command="{Binding Digests.OpenDigestPageCommand}" Width="200" Margin="0,0,8,0"/>
                    <Button Content="创建 Digest (TODO)" Command="{Binding Digests.CreateDigestCommand}" Width="160"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Digests.Digests}" AutoGenerateColumns="False" Grid.Row="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="频率" Binding="{Binding Schedule}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="日志">
            <Grid Margin="12">
                <ListBox ItemsSource="{Binding Logs.Lines}"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
